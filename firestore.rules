rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // sessions/{session}/players/{uid}: one document per phone
    match /sessions/{session}/players/{uid} {

      // Anyone can read, so the projector leaderboard needs no login
      allow read: if true;

      // A phone may only write its OWN row (uid comes from anonymous sign-in)
      allow create: if isOwner(uid) && valid(request.resource.data)
        && (!('bingoAt' in request.resource.data) || request.resource.data.bingoAt == request.time);

      // bingoAt can be set once, only to the server's clock, and never changed afterwards
      allow update: if isOwner(uid) && valid(request.resource.data)
        && (('bingoAt' in resource.data)
              ? request.resource.data.get('bingoAt', null) == resource.data.bingoAt
              : (!('bingoAt' in request.resource.data) || request.resource.data.bingoAt == request.time));

      allow delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function valid(d) {
      return d.keys().hasOnly(['name', 'done', 'stage', 'mistakes', 'bingoAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.done is int && d.done >= 0 && d.done <= 9
        && d.stage is int && d.stage >= 1 && d.stage <= 3
        && d.mistakes is int && d.mistakes >= 0;
    }
  }
}
